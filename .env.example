# Google Sheets service account (used only by server-side API routes)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private key from the service account JSON. Keep the \n escape sequences.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# The Google Sheet ID containing all data
# Sheet tabs used:
#   "Data"                       – Quotation submissions
#   "Mastersheet"                – Customer master
#   "Products"                   – Parts master
#   "Followup Form for Quotation" – Follow-up / order-status history log
#   "Users"                      – Username / Password / Active / Email / Role
GOOGLE_SHEET_ID=your-google-sheet-id

# Secret used to sign the authentication session cookie (HMAC-SHA256).
# Keep it private and stable: changing it invalidates all active sessions.
AUTH_SECRET=your-random-secret

# ─── Email Configuration (Daily CRM Reports) ─────────────────────────────────
# SMTP settings for sending daily quotation/CRM reports.
# For Gmail: use smtp.gmail.com with port 587 and a Gmail App Password.
#
# SMTP_USER  = DME/office Gmail account used for SMTP authentication
# SMTP_PASS  = Gmail App Password (not your regular Gmail password)
# SMTP_FROM  = DME/office email shown as the sender in received emails
#
# These are sender configuration values, NOT recipient configuration.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-dme-office-email@deepsikha.in
SMTP_PASS=your-app-password
SMTP_FROM=your-dme-office-email@deepsikha.in
EMAIL_FROM_NAME=Quotation

# ─── Email Recipients ─────────────────────────────────────────────────────────
# Daily report recipients are resolved dynamically from the "Users" Google Sheet.
#
# User report:
#   Uses the authenticated user's User Directory record.
#   User must be Active and have a valid Email.
#
# Admin report:
#   Sends to all Active users whose Role is "Admin"
#   and who have a valid Email.
#   Multiple Admin recipients are supported.
#
# Do NOT configure report recipient email addresses here.
# REPORT_ADMIN_EMAILS and REPORT_TEST_USER_EMAIL are no longer used.

# Set to "true" to use test/dummy data instead of live Google Sheets data.
# Only for testing — do NOT leave enabled in production.
EMAIL_TEST_MODE=false

# ─── OTD Quotation Sync ──────────────────────────────────────────────────────
# When a quotation Order Status is set to "Won", the complete quotation is
# synced to OTD via POST /api/sync/quotations with Bearer authentication.
#
# O2D_SYNC_API_URL = Full URL of the OTD sync endpoint
# O2D_SYNC_SECRET  = Bearer token shared with the OTD application
#
# Both variables are server-side only. NEVER use NEXT_PUBLIC_ prefix.
# NEVER log or expose O2D_SYNC_SECRET.
O2D_SYNC_API_URL=http://localhost:3001/api/sync/quotations
O2D_SYNC_SECRET=your-otd-sync-secret

# ─── Vercel Cron ─────────────────────────────────────────────────────────────
# Secret used to authenticate the daily-report cron endpoint.
# Only required for Vercel deployments with cron enabled.
CRON_SECRET=local-o2d-test-secret-2026
